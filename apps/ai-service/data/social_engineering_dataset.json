    "labels": { "urgency": 0, "fear_intimidation": 1, "authority_impersonation": 1, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-017",
    "text": "Main FIA Cyber Crime Unit se Inspector Imran bol raha hoon, foran cooperate karein.",
    "language": "roman_ur",
    "labels": { "urgency": 1, "fear_intimidation": 1, "authority_impersonation": 1, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-018",
    "text": "IT Support Administrator speaking. You must comply with security audit policy immediately.",
    "language": "en",
    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 1, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-019",
    "text": "State Bank of Pakistan Verification Helpline: Your CNIC verification is incomplete.",
    "language": "en",
    "labels": { "urgency": 1, "fear_intimidation": 0, "authority_impersonation": 1, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-020",
    "text": "CEO Direct Order: Process this wire transfer immediately and keep it confidential.",
