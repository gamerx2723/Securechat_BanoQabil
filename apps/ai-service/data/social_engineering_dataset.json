    "labels": { "urgency": 1, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-015",
    "text": "فوری طور پر تصدیق کریں ورنہ آپ کا اکاؤنٹ بند کر دیا جائے گا",
