    "labels": { "urgency": 1, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 1 }
  },
  {
    "id": "SE-025",
    "text": "Apna password aur OTP code mujhe send kar do verification ke liye.",
    "language": "roman_ur",
    "labels": { "urgency": 1, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 1 }
  },
  {
    "id": "SE-026",
    "text": "Enter your secret recovery seed phrase to unlock your cryptocurrency wallet.",
