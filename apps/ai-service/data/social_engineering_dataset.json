    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-010",
    "text": "آپ کی رپورٹ موصول ہو گئی ہے، بہت شکریہ۔",
    "language": "ur",
    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-011",
    "text": "URGENT: Your account will be terminated in 15 minutes unless you respond now!",
    "language": "en",
    "labels": { "urgency": 1, "fear_intimidation": 1, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-012",
    "text": "Foran verify karo warna account hamesha k liye block ho jaye ga!",
    "language": "roman_ur",
    "labels": { "urgency": 1, "fear_intimidation": 1, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-013",
    "text": "Immediate action required! Your credit card has been suspended due to fraudulent activity.",
