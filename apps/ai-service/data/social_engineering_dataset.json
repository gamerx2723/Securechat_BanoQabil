    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 1 }
  },
  {
    "id": "SE-027",
    "text": "Login with your credentials immediately to avoid account suspension.",
