    "labels": { "urgency": 1, "fear_intimidation": 1, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-016",
    "text": "This is Federal Cyber Police Officer Davis. You are under immediate investigation.",
