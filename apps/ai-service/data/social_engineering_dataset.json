[
  {
    "id": "SE-001",
    "text": "Hey! How is the project going? Let me know if you want to meet for coffee.",
    "language": "en",
    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-002",
    "text": "Good morning team, the weekly sprint retrospective is at 3pm today.",
