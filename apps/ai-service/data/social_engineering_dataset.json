    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-005",
    "text": "Please review the attached budget proposal before tomorrow morning.",
    "language": "en",
    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-006",
    "text": "Salam, ghar kab tak aao ge?",
