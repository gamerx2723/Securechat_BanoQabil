    "labels": { "urgency": 0, "fear_intimidation": 1, "authority_impersonation": 0, "secrecy_isolation": 1, "credential_solicitation": 0 }
  },
  {
    "id": "SE-023",
    "text": "Keep this conversation strictly private between us. Do not consult with your supervisor.",
