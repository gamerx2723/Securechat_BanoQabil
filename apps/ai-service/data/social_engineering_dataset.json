    "labels": { "urgency": 1, "fear_intimidation": 0, "authority_impersonation": 1, "secrecy_isolation": 1, "credential_solicitation": 0 }
  },
  {
    "id": "SE-021",
    "text": "Do not tell anyone or discuss this with your colleagues. It is strictly confidential.",
    "language": "en",
    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 1, "credential_solicitation": 0 }
  },
  {
    "id": "SE-022",
    "text": "Kisi ko mat batana, chup chap akele ye step complete karo warna nuksan hoga.",
