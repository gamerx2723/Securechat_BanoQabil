    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-007",
    "text": "Thanks for sending over the meeting minutes, looks good to me.",
    "language": "en",
    "labels": { "urgency": 0, "fear_intimidation": 0, "authority_impersonation": 0, "secrecy_isolation": 0, "credential_solicitation": 0 }
  },
  {
    "id": "SE-008",
    "text": "The server deployment finished successfully without downtime.",
