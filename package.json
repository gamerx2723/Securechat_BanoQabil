{
  "name": "securechat-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SecureChat — AI-Powered Zero-Trust Secure Messaging Platform & SecureBridge Companion",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "npm --prefix packages/database run generate",
    "db:seed": "npm --prefix packages/database run seed",
    "start:api": "npm --prefix apps/api run start:dev",
    "start:ai": "cd apps/ai-service && python -m uvicorn src.main:app --reload --port 8000",
    "start:web": "npm --prefix apps/web run dev"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
